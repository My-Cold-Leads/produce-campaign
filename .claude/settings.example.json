{
  "_comment": "Merge these into your own .claude/settings.json. If you already have a settings.json, add the entries inside the arrays rather than replacing the file. $CLAUDE_PROJECT_DIR is expanded by Claude Code and is the only form robust to the working directory.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-push-safe-required.sh", "timeout": 10 },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-deliverability-hardening.sh", "timeout": 10 },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-custom-field-syntax.sh", "timeout": 10 },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-abstention-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-prompt-cache-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-durable-writes.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-custom-field-syntax.sh", "timeout": 10 },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-prompt-cache-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-durable-writes.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
